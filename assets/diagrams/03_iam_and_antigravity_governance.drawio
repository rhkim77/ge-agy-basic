        <mxCell id="r_dev" value="&lt;b&gt;Predefined Role: roles/discoveryengine.agentspaceUser&lt;/b&gt;&lt;hr/&gt;• Assigned to Approved Developers &amp;amp; AX Engineers&lt;br/&gt;• 135 Permissions Included&lt;br/&gt;• Grants full GE Web App + Canvas + Google Antigravity&lt;br/&gt;• Platform Admins also require this role (AND rule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
