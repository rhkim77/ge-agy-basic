        <mxCell id="top_id" value="&lt;b&gt;Identity &amp;amp; Pooled Seat Entitlement (locations/global)&lt;/b&gt;&lt;br/&gt;Google Identity / Workforce Identity Federation · 30-Day Free-Trial or Standard Subscription · Multiplier = 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FB8C00;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
