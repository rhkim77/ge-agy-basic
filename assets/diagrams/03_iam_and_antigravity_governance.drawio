        <mxCell id="dest_ge" value="&lt;b&gt;General Employees Surface&lt;/b&gt;&lt;hr/&gt;• Gemini Enterprise Web App Search &amp;amp; Chat&lt;br/&gt;• Shared Agent Designer Workflows&lt;br/&gt;• Canvas Local File Download (.docx / .pdf / .pptx / .html)&lt;br/&gt;• &lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Antigravity IDE / CLI Blocked (HTTP 403)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
