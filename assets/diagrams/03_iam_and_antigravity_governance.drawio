        <mxCell id="r_biz" value="&lt;b&gt;Custom IAM Role: geStandardChatUser&lt;/b&gt;&lt;hr/&gt;• Derived from roles/discoveryengine.agentspaceUser&lt;br/&gt;• 129 Permissions Included&lt;br/&gt;• Retains 7 discoveryengine.immersiveArtifacts.* (Canvas)&lt;br/&gt;• &lt;b&gt;Removes 5 businessaicode.locations.* Permissions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
