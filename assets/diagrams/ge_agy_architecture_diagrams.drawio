        <mxCell id="title" value="&lt;b style=&quot;font-size:18px;&quot;&gt;Cymbal Beauty &amp;amp; Living: Gemini Enterprise 1P DataStore &amp;amp; Google Antigravity Architecture&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5F6368&quot; style=&quot;font-size:12px;&quot;&gt;Single GCP Project Boundary · Non-GWS Authentication · Role-Separated Citizen &amp;amp; Developer Surfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1.5;align=left;spacingLeft=20;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
