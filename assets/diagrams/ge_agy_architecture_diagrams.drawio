        </mxCell>
        <mxCell id="s2_1" value="&lt;b&gt;1. MD / Sales Planner Query&lt;/b&gt;&lt;br/&gt;SKU-LUMI-001 Duty-Free ROI Drop &amp;amp;&lt;br/&gt;SKU-VERD-004 H&amp;amp;B Stock-Out Risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="s2_lane"><mxGeometry x="30" y="65" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="s2_2" value="&lt;b&gt;2. Root Node: root_sales (LlmAgentNode)&lt;/b&gt;&lt;br/&gt;• BigQuery: cbl-ds-bq-sales-inventory (3,600 rows)&lt;br/&gt;• GCS: cbl-ds-sales-policy (Discount Cap &amp;amp; &lt;50% Safety Stock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FB8C00;strokeWidth=2;" vertex="1" parent="s2_lane"><mxGeometry x="430" y="65" width="460" height="100" as="geometry"/></mxCell>
