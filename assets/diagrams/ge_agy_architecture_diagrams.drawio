        <mxCell id="s2_lane" value="&lt;b&gt;Scenario 2: Brand &amp;amp; Channel Sales / Inventory Risk Analysis Agent (Low-Code Cross-Source RAG)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;startSize=32;collapsible=0;fontFamily=Helvetica;fontColor=#1B5E20;" vertex="1" parent="1">
