        <mxCell id="s1_lane" value="&lt;b&gt;Scenario 1: Cosmetic Ad-Copy Compliance Pre-Review Workflow (SequentialAgentNode)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;startSize=32;collapsible=0;fontFamily=Helvetica;fontColor=#01579B;" vertex="1" parent="1">
