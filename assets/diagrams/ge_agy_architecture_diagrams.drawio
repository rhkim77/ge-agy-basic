        <mxCell id="agy_box" value="&lt;b&gt;Google Antigravity (Desktop IDE / agy CLI)&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;• agy_workspace/.agent/rules/ (Cosmetic Act + Read-Only)&lt;br/&gt;• .agent/skills/ (ad-compliance-auditor, bq-ops-analyzer)&lt;br/&gt;• Allowed MCP: bigquery + local-copy-auditor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#0288D1;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="lane_ai">
