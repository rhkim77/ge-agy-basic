# Target Google Cloud Project & Gemini Enterprise Configuration
PROJECT_ID="YOUR_PROJECT_ID"
GE_LOCATION="global"
GE_ENGINE_ID="YOUR_GE_ENGINE_ID"

# Cloud Storage & BigQuery Demo Resources
# If GCS_BUCKET is left empty, defaults to "${PROJECT_ID}-cbl-ge-demo"
GCS_BUCKET=""
BQ_DATASET="cbl_ge_demo"
BQ_LOCATION="US"

# Discovery Engine 1P DataStore Prefix
DS_PREFIX="cbl-ds"
